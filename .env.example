# .env.example — copy to .env (git-ignored) and fill in locally. Never commit real values.
# Each variable is added in the phase that first needs it.

# --- Phase 3: local Kusto emulator (no secret; local only) ---
KUSTO_EMULATOR_URL=http://localhost:8080

# --- Phase 4: AI triage agent ---
OLLAMA_HOST=http://localhost:11434
# Optional; leave empty to use Ollama or the replay provider.
ANTHROPIC_API_KEY=

# --- Phase 6: live lab (IDs only; authentication uses `az login` / OIDC, not secrets) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
LOG_ANALYTICS_WORKSPACE_ID=
