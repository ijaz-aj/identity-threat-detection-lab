// SYNTHETIC LAB DATA, not real telemetry.
// The 9 sign-ins from my Phase 1 password-spray triage exercise.
// IPs come from documentation ranges (RFC 5737) and lab.example is a reserved example domain.
// Columns and types are a subset of the real SigninLogs schema (see docs/references.md).
// Note: ResultType is a STRING in SigninLogs, so compare it with "50126", not 50126.
//
// Load it:  .venv\Scripts\python scripts\kql.py --file data\samples\password_spray_mini.kql

.create database lab persist (@"/kustodata/dbs/lab/md", @"/kustodata/dbs/lab/data") ifnotexists

.create-merge table SigninLogs (TimeGenerated: datetime, UserPrincipalName: string, IPAddress: string, Location: string, ResultType: string)

.clear table SigninLogs data

.ingest inline into table SigninLogs <|
2026-11-01T09:00:12Z,alice@lab.example,198.51.100.20,IN,50126
2026-11-01T09:00:40Z,alice@lab.example,198.51.100.20,IN,0
2026-11-01T09:14:02Z,adam@lab.example,203.0.113.50,NL,50126
2026-11-01T09:14:09Z,bob@lab.example,203.0.113.50,NL,50126
2026-11-01T09:14:15Z,chen@lab.example,203.0.113.50,NL,50126
2026-11-01T09:14:22Z,divya@lab.example,203.0.113.50,NL,0
2026-11-01T09:14:28Z,emre@lab.example,203.0.113.50,NL,50126
2026-11-01T09:14:35Z,farah@lab.example,203.0.113.50,NL,50053
2026-11-01T09:20:51Z,bob@lab.example,198.51.100.21,IN,0

SigninLogs | count
